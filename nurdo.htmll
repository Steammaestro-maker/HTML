<h1 id = "callme">№.04 Давай свяжемся</h1>
<p>Есть вопросы? Свяжись со мной</p>
<form>
    <section>    
        <fieldset>
          <legend>Контактная форма</legend>
          <p>
            <label for="student-name">Имя:</label><br>
            <input type="text" id="student-name" name="student_name" placeholder="" required minlength="2" maxlength="80">
          </p>
          <p>
            <label for="email">Email:</label><br>
            <input type="email" id="email" name="email" placeholder="">
          </p>
          <p>
            <label for="phone">Телефон:</label><br>
            <input type="tel" id="phone" name="phone" placeholder="">
          </p>
          <p>
            <label for="direction">Тема:</label>
            <select id="direction" name="direction">
                <option value="web">Вопрос</option>
                <option value="data">Совет</option>
                <option value="finance">Партнерская программа</option>
            </select>
          </p>
            <label for="message">Твой текст</label><br>
            <textarea id="message" name="message" rows="4" cols="40" placeholder="Напиши несколько предложений"></textarea>
          </p>
        </fieldset>
        <p>
          <button type="submit" disabled>Отправка не подключена</button>
          <button type="reset">Сбросить анкету</button>
        </p>
        <!-- reset возвращает начальные значения, а не обязательно очищает всё.
             Для реальной отправки нужны обработчик, action и подходящий method.
             Загрузка файлов обычно требует method="post" и enctype="multipart/form-data". -->
      </form>
    </section>










