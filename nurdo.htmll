    <!-- table — таблица; caption — её название; tr — строка;
           th — заголовочная ячейка; td — ячейка с данными.
           Без CSS браузер может не рисовать границы. Это нормально. -->
      <table border="3">
        <caption>Мои умения</caption>
        <thead>
          <tr>
            <th scope="col">Ниша</th>
            <th scope="col">Достижение</th>
            <th scope="col">Возраст</th>
            <th scope="col">Стаж</th>
          </tr>
        </thead>
